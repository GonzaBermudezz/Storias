# ── Copiar como .env y completar los valores ──────────────────────────────────
# NUNCA subir el .env real a git.

# App
ENVIRONMENT=development
SECRET_KEY=generá-con-python-secrets.token-hex-32
ALLOWED_ORIGINS=["http://localhost:5001"]

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...     # PRIVADO — nunca al frontend

# Google OAuth
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_REDIRECT_URI=http://localhost:5001/auth/callback

# Claude API
ANTHROPIC_API_KEY=sk-ant-xxxx

# Meta / WhatsApp (dejar vacío en dev para simular)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Encryption key para datos de clientes en DB
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0
